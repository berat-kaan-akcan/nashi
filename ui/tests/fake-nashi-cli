        print("nashi-cli: cannot inspect file", file=sys.stderr)
        return 1
    if any(f.endswith(".slow") for f in files):
        time.sleep(1.0)
    ext = files[0].rsplit(".", 1)[-1].lower() if files else ""
    cat = {"mp4": "video", "png": "image", "jpg": "image"}.get(ext, "unknown")
    data = {
        "files": [{"path": f, "ext": f.rsplit(".", 1)[-1], "category": cat} for f in files],
        "convert": [
            {"id": "mp3", "title": "MP3", "available": True},
            {"id": "gif", "title": "GIF", "available": True},
            {"id": "webm", "title": "WEBM", "available": False, "missing": ["ffmpeg"]},
        ],
        "tools": [
            {"id": "compress", "title": {"en": "Compress", "tr": "Sıkıştır"}, "icon": "archive-insert",
             "available": True, "needs_editor": False},
            {"id": "trim", "title": {"en": "Trim", "tr": "Kırp"}, "icon": "edit-cut",
             "available": True, "needs_editor": True},
            {"id": "removeMetadata", "title": {"en": "Remove Metadata", "tr": "Meta Veriyi Sil"},
             "icon": "edit-clear", "available": False, "needs_editor": False, "missing": ["exiftool"]},
        ],
        "actions": [
            {"id": "copy", "title": {"en": "Copy", "tr": "Kopyala"}, "icon": "edit-copy"},
            {"id": "copyPath", "title": {"en": "Copy Path", "tr": "Yolu Kopyala"}, "icon": "edit-copy"},
            {"id": "terminal", "title": {"en": "Open Terminal", "tr": "Terminal Aç"}, "icon": "utilities-terminal"},
            {"id": "openFolder", "title": {"en": "Open Folder", "tr": "Klasörü Aç"}, "icon": "folder-open"},
            {"id": "reveal", "title": {"en": "Show in File Manager", "tr": "Dosya Yöneticisinde Göster"},
             "icon": "system-file-manager"},
