def deps():
    print(json.dumps({"tools": [
        {"id": "ffmpeg", "available": True, "version": "7.1", "path": "/usr/bin/ffmpeg",
         "package": "ffmpeg", "optional": False, "used_for": ["audio", "video", "gif"]},
        {"id": "exiftool", "available": False, "version": None, "path": None,
         "package": "perl-image-exiftool", "optional": False, "used_for": ["removeMetadata"]},
        {"id": "pandoc", "available": False, "version": None, "path": None,
         "package": "pandoc-cli", "optional": True, "used_for": ["document"]},
    ]}))
    return 0


def inspect_cmd(files):
    items = []
    for f in files:
        ext = f.rsplit(".", 1)[-1].lower() if "." in f else ""
        cat = {
            "mp4": "video", "mkv": "video", "webm": "video",
            "mp3": "audio", "wav": "audio", "flac": "audio",
            "png": "image", "jpg": "image", "jpeg": "image", "webp": "image",
            "gif": "gif", "pdf": "pdf", "txt": "text", "md": "text",
        }.get(ext, "unknown")
        items.append({
            "path": f,
            "ext": ext,
            "category": cat,
            "size": 12345,
            "duration": 12.5 if cat in ("video", "audio", "gif") else None,
            "width": 640 if cat in ("video", "image", "gif") else None,
            "height": 360 if cat in ("video", "image", "gif") else None,
            "pages": 4 if cat == "pdf" else None,
        })
    print(json.dumps({"files": items}))
    return 0


def metadata_cmd(args):
    files = [a for a in args if not a.startswith("--")]
    if files and files[0].endswith(".txt"):
        print(json.dumps({"error": {"code": "unsupported", "message": "no metadata here"}}))
        return 1
    print(json.dumps({"fields": [
        {"key": "IFD0:Artist", "value": "Someone", "editable": True},
        {"key": "PNG:ImageWidth", "value": "640", "editable": False},
        {"key": "XMP-dc:Title", "value": "Old title", "editable": True},
    ]}))
    return 0


def preview_cmd(args):
    if not args:
        return 2
    src = args[0]
    kind = "frame"
    out_dir = ""
    width = 0
    height = 0
    pages_spec = ""
    i = 1
    while i < len(args):
        k = args[i]
        v = args[i + 1] if i + 1 < len(args) else ""
        if k == "--kind":
            kind = v
            i += 2
        elif k == "--out-dir":
            out_dir = v
            i += 2
        elif k == "--width":
            width = int(v)
            i += 2
        elif k == "--height":
            height = int(v)
            i += 2
        elif k == "--pages":
            pages_spec = v
            i += 2
        elif k in ("--at", "--color"):
            i += 2
        else:
            i += 1
    if not out_dir or src.endswith(".bad"):
        print(json.dumps({"error": {"code": "invalid_input", "message": "cannot preview file"}}))
        return 1
    if kind == "waveform":
        w = min(width or 320, 320)
        h = min(height or 80, 160)
        p = os.path.join(out_dir, "waveform.png")
        write_png(p, w, h, (48, 84, 59, 180))
        print(json.dumps({"kind": "waveform", "files": [p], "width": w, "height": h}))
        return 0
    if kind == "pages":
        w = min(width or 120, 240)
        h = int(w * 1.41)
        count = 4 if not pages_spec else len(pages_spec.split(","))
        out = []
        for idx in range(1, max(1, count) + 1):
            p = os.path.join(out_dir, f"page-{idx:03d}.png")
            write_png(p, w, h, (245 - idx * 15, 240 - idx * 10, 225, 255))
            out.append(p)
        print(json.dumps({"kind": "pages", "files": out, "width": w, "height": h}))
        return 0
    w = min(width or 320, 320)
    h = int(w * 9 / 16)
    p = os.path.join(out_dir, "frame.png")
    write_png(p, w, h, (95, 135, 110, 255))
    print(json.dumps({"kind": "frame", "files": [p], "width": w, "height": h}))
    return 0


def download_cmd(args):
    url = ""
    kind = "auto"
    out_dir = "/tmp"
    i = 0
    while i < len(args):
        if args[i] == "--":
            if i + 1 < len(args):
                url = args[i + 1]
            break
        if args[i] == "--kind" and i + 1 < len(args):
            kind = args[i + 1]
            i += 2
        elif args[i] == "--out-dir" and i + 1 < len(args):
            out_dir = args[i + 1]
            i += 2
        elif not url:
            url = args[i]
            i += 1
        else:
            i += 1
    emit({"event": "start", "job": "dl01", "total": 1})
    if not (url.startswith("http://") or url.startswith("https://")):
        emit({"event": "error", "input": url, "index": 0, "code": "invalid_input", "message": "Only http/https URLs"})
        emit({"event": "done", "outputs": [], "failed": 1, "cancelled": False})
        return 1
    ext = {"audio": "mp3", "thumbnail": "png", "image": "png"}.get(kind, "mp4")
    out = os.path.join(out_dir, f"downloaded.{ext}")
    emit({"event": "progress", "input": url, "index": 0, "fraction": 0.5, "message": "Downloading"})
    emit({"event": "output", "input": url, "index": 0, "path": out})
    emit({"event": "done", "outputs": [out], "failed": 0, "cancelled": False})
    return 0


def run_job(op, ident, files):
    cancelled = {"flag": False}

    def on_term(_sig, _frm):
        cancelled["flag"] = True

    if ident == "stubborn":
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    else:
        signal.signal(signal.SIGTERM, on_term)
        signal.signal(signal.SIGINT, on_term)

    emit({"event": "start", "job": "7f3c", "total": len(files)})
    if ident in ("slow", "stubborn", "slowclean"):
        for i in range(600):
            if cancelled["flag"]:
                if ident == "slowclean":
                    time.sleep(1.0)
                    mark = os.environ.get("FAKE_CLI_CLEANUP_MARK")
                    if mark:
                        with open(mark, "w", encoding="utf-8") as fh:
                            fh.write("clean\n")
                emit({"event": "done", "outputs": [], "failed": 0, "cancelled": True})
                return 130
            emit({"event": "progress", "input": files[0], "index": 0, "fraction": None, "message": "Waiting"})
            time.sleep(0.05)
        return 0
    if ident == "merge":
        for frac in (0.25, 0.5, 0.75):
            emit({"event": "progress", "input": None, "index": None, "fraction": frac, "message": "Merging"})
            time.sleep(0.05)
        out = files[0].rsplit("/", 1)[0] + "/merged.pdf"
        emit({"event": "output", "input": None, "index": None, "path": out})
        emit({"event": "done", "outputs": [out], "failed": 0, "cancelled": False})
        return 0
    if ident == "qr":
        out = files[0] + ".txt"
        emit({"event": "output", "input": files[0], "index": 0, "path": out, "message": "https://example.org/42"})
        emit({"event": "done", "outputs": [out], "failed": 0, "cancelled": False})
        return 0
    if ident == "nodone":
        print("nashi-cli: something went wrong", file=sys.stderr)
        return 3
    outputs = []
    failed = 0
    for i, f in enumerate(files):
        if ident == "garbage":
            sys.stdout.write("this is not json\n")
        emit({"event": "progress", "input": f, "index": i, "fraction": 0.5, "message": "Encoding"}, partial=True)
        if ident == "fail":
            emit({"event": "error", "input": f, "index": i, "code": "tool_failed", "message": "ffmpeg exited with 1"})
            failed += 1
            continue
        stem = f.rsplit(".", 1)[0]
        out = stem + "." + (ident if op == "convert" else "out")
        outputs.append(out)
        emit({"event": "output", "input": f, "index": i, "path": out})
    # The final line has no trailing newline to exercise flush-at-EOF.
    sys.stdout.write(json.dumps({"event": "done", "outputs": outputs, "failed": failed, "cancelled": False}))
    sys.stdout.flush()
    return 1 if failed else 0


def main(argv):
    log = os.environ.get("FAKE_CLI_ARGV_LOG")
    if log:
        with open(log, "w", encoding="utf-8") as fh:
            fh.write("\n".join(argv))
    args = [a for a in argv if a != "--json"]
    if not args:
        print("usage", file=sys.stderr)
        return 2
    cmd = args[0]
    if cmd == "wheel":
        return wheel(args[1:])
    if cmd == "deps":
        return deps()
    if cmd == "inspect":
        return inspect_cmd(args[1:])
    if cmd == "metadata":
        return metadata_cmd(args[1:])
    if cmd == "preview":
        return preview_cmd(args[1:])
    if cmd == "download":
        return download_cmd(args[1:])
    if cmd in ("convert", "tool") and len(args) >= 3:
        rest = args[2:]
        files = []
        i = 0
        while i < len(rest):
            if rest[i] in ("--out-dir", "--options"):
                i += 2
                continue
            files.append(rest[i])
            i += 1
        return run_job(cmd, args[1], files)
    print("usage error", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
