# Fails when the .ts file has unfinished or empty translations.
file(READ "${TS_FILE}" ts)
string(REGEX MATCHALL "<translation type=\"unfinished\"" unfinished "${ts}")
string(REGEX MATCHALL "<translation></translation>" empty "${ts}")
list(LENGTH unfinished n_unfinished)
list(LENGTH empty n_empty)
string(REGEX MATCHALL "<message[ >]" messages "${ts}")
list(LENGTH messages n_messages)
if(n_messages EQUAL 0)
    message(FATAL_ERROR "${TS_FILE}: no messages")
endif()
if(n_unfinished GREATER 0 OR n_empty GREATER 0)
    message(FATAL_ERROR "${TS_FILE}: ${n_unfinished} unfinished, ${n_empty} empty of ${n_messages}")
endif()
message(STATUS "${TS_FILE}: ${n_messages} messages, all translated")
